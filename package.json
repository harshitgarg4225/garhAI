{
  "name": "garh-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Garh AI — India-first, AI-native house design platform for architects (monorepo root)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @garh/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm --filter @garh/model test:watch",
    "test:golden": "pnpm -r --if-present test:golden",
    "e2e": "pnpm --filter @garh/e2e test",
    "e2e:smoke": "pnpm --filter @garh/e2e test:smoke",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "@eslint/js": "9.12.0",
    "@types/node": "20.16.11",
    "eslint": "9.12.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.12",
    "globals": "15.11.0",
    "prettier": "3.3.3",
    "typescript": "5.6.2",
    "typescript-eslint": "8.8.1",
    "vitest": "2.1.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "18",
        "react-dom": "18"
      }
    }
  }
}
