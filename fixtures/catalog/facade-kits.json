        "materialId": "wpc-cladding",
        "widthMm": 1200
      },
      "porch": {
        "style": "cantilever",
        "projectionMm": 1800,
        "thicknessMm": 200
      },
      "railing": {
        "style": "ms-slim",
        "heightMm": 1050,
        "materialId": "ms-railing"
      }
