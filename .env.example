# ══════════════════════════════════════════════════════════════════════════════
# Garh AI — environment template (playbook §18)
#
#   cp .env.example .env && make dev-keys && docker compose up
#
# Every value below is a WORKING LOCAL DEFAULT. A fresh clone needs zero
# secrets, zero API keys and zero GPUs: the LLM, render and billing providers
# all default to deterministic mocks. Real providers are opt-in.
#
# ── Variable names are a contract ─────────────────────────────────────────────
# The API reads these through apps/api/garh_api/config.py (pydantic-settings,
# case-insensitive, `extra="ignore"`). A NAME MISMATCH IS SILENT: the setting
# falls back to its dev default and nothing warns you. If you add or rename a
# variable here, change the matching field in config.py in the same commit.
#
# ── How to read the markers ───────────────────────────────────────────────────
#   [server]  read by the API process
#   [worker]  read by worker processes — solver / render / drawings
#   [both]    API and workers
#   [client]  VITE_-prefixed; COMPILED INTO THE BROWSER BUNDLE. Public forever.
#
#   Anything not marked [client] must never appear in apps/web/. CI enforces
#   this (`make secret-audit`, §13 "secrets never in client bundle").
# ══════════════════════════════════════════════════════════════════════════════


# ─── Compose / app identity ───────────────────────────────────────────────────
# The checkout directory is "Garh AI" — a space and capitals, which Compose
# rejects as a derived project name. This must stay set. See DECISIONS.md.
COMPOSE_PROJECT_NAME=garh-ai

# One of: dev | test | staging | prod  (config.py `Environment` literal).
# Anything else fails validation at boot. Outside `dev`, config.py refuses to
# start until the real secrets below are set — see _fail_fast_on_missing_secrets.
APP_ENV=dev                                    # [both]
APP_URL=http://localhost:5173                  # public web origin; share links are built from it  [both]
API_PREFIX=/api/v1                             # [server]
DEBUG=false                                    # [server]

API_PORT=8000                                  # host port publishing only (not read by the app)
WEB_PORT=5173
WEB_HMR_PORT=24678


# ─── Observability (§18) ──────────────────────────────────────────────────────
LOG_LEVEL=INFO                                 # CRITICAL|ERROR|WARNING|INFO|DEBUG|NOTSET   [both]
LOG_FORMAT=json                                # json (structlog) | console (dev-readable)   [both]
SQL_ECHO=false                                 # echo SQLAlchemy statements — very noisy   [both]
SENTRY_DSN=                                    # blank = error hook disabled   [both]
SENTRY_TRACES_SAMPLE_RATE=0.0                  # [both]


# ─── Postgres ─────────────────────────────────────────────────────────────────
# POSTGRES_* configure the postgres container itself; DATABASE_URL is what the
# app reads. Keep the credentials in the two consistent.
POSTGRES_USER=garh
POSTGRES_PASSWORD=garh_local_dev               # local only; rotate for any shared deploy
POSTGRES_DB=garh
POSTGRES_PORT=5432

# In-container DSN (service name `postgres`), psycopg 3 driver.               [both]
DATABASE_URL=postgresql+psycopg://garh:garh_local_dev@postgres:5432/garh
# Same database from your laptop — psql, a host-run pytest, or a GUI client.
# Not read by the app; used by tooling and documented here so it stays in sync.
DATABASE_URL_HOST=postgresql+psycopg://garh:garh_local_dev@localhost:5432/garh

DB_POOL_SIZE=10                                # [both]
DB_MAX_OVERFLOW=10                             # [both]
DB_POOL_TIMEOUT_SECONDS=30                     # [both]
DB_POOL_RECYCLE_SECONDS=1800                   # [both]
DB_STATEMENT_TIMEOUT_MS=15000                  # a runaway query must not hold a request open   [both]

API_MIGRATE_ON_BOOT=true                       # compose runs `alembic upgrade head` before serving


# ─── Redis (queues + rate limits + SSE fan-out) ───────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0                 # [both]
REDIS_URL_HOST=redis://localhost:6379/0        # tooling only

QUEUE_SOLVER=garh:queue:solver                 # [both]
QUEUE_RENDER=garh:queue:render                 # [both]
QUEUE_DRAWINGS=garh:queue:drawings             # [both]

WORKER_SOLVER_CONCURRENCY=2                    # [worker]
WORKER_RENDER_CONCURRENCY=1                    # [worker] real diffusers wants a whole GPU
WORKER_DRAWINGS_CONCURRENCY=2                  # [worker]
QUEUE_VISIBILITY_TIMEOUT_SECONDS=900           # job lease; solver budget is 60s, CI runs slower   [worker]
QUEUE_MAX_RETRIES=3                            # then dead-letter; UI shows it honestly (§15 rule 9)   [worker]
QUEUE_RETRY_BACKOFF_SECONDS=5                  # [worker]
SOLVER_NUM_SEARCH_WORKERS=8                    # CP-SAT threads per job (§5.2)   [worker]
SOLVER_TIME_BUDGET_SECONDS=15                  # per stair-candidate (§5.2)   [worker]


# ─── Auth: JWT RS256 (§13) ────────────────────────────────────────────────────
# RS256 (not HS256) so the read-only share-link surface can verify with the
# public key alone and never holds signing material.
#
# The keys are passed INLINE as single-line PEMs with literal \n between lines.
# config.py's _normalise_pem validator turns those two characters back into real
# newlines, so this is the supported form — there is no *_FILE variant.
#
# GENERATE A DEV KEYPAIR:
#
#   make dev-keys        # writes .keys/*.pem AND fills in the two vars below
#
# Or by hand:
#   mkdir -p .keys
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out .keys/jwt-private.pem
#   openssl rsa -in .keys/jwt-private.pem -pubout -out .keys/jwt-public.pem
#   # then collapse each PEM to one line with literal \n:
#   awk 'BEGIN{ORS="\\n"}1' .keys/jwt-private.pem
#
# Left blank here on purpose: `docker compose up` mints a throwaway dev keypair
# on first boot when JWT_PRIVATE_KEY is empty, so the stack starts with no
# preparation at all. Set them (or run `make dev-keys`) when you need the same
# keys for host-run tests and the container to agree.
JWT_PRIVATE_KEY=                               # [server] SIGNING KEY — never leaves the API
JWT_PUBLIC_KEY=                                # [both]  verification only
JWT_ALGORITHM=RS256                            # [both]
JWT_ISSUER=garh-ai                             # [both]

ACCESS_TOKEN_TTL_SECONDS=900                   # 15 min (§11)   [server]
REFRESH_TOKEN_TTL_SECONDS=2592000              # 30 days, rotated on use (§13)   [server]
OTP_TTL_SECONDS=600                            # 10 min (§13)   [server]
OTP_MAX_ATTEMPTS=5                             # then the code is burned (§13)   [server]
OTP_CODE_LENGTH=6                              # [server]
SHARE_TOKEN_BYTES=32                           # 256-bit, stored hashed (§13)   [server]

# DEV_ECHO_OTP — the one reason `docker compose up` → sign in works with no mail
# provider. When on, POST /auth/otp returns the code in the response body as
# `devCode` and the login screen shows it. Double-gated in garh_api/auth.py:
# APP_ENV must be dev|test AND this must not be explicitly falsy, so there is no
# value of it that leaks a code from staging or prod. Default is ON in dev, which
# is why a fresh clone signs in; set it to 0 to rehearse the real mail path.
# Read via os.environ, not a Settings field (pydantic-settings' extra="ignore"
# would have swallowed a typo silently).
DEV_ECHO_OTP=1                                 # dev/test only — impossible elsewhere   [server]

# TRUSTED_PROXY_HOPS — how many X-Forwarded-For entries to trust from the right.
# 0 means the header is IGNORED entirely and the socket peer is the client IP.
# Leave it at 0 unless a load balancer you control is in front: a forgeable
# client IP means forgeable per-IP rate-limit buckets (§13). Behind an LB with
# this at 0, every caller shares one bucket — that throttles rather than
# over-admits, which is the safe direction to be wrong in.
TRUSTED_PROXY_HOPS=0                           # [server]

CORS_ALLOW_ORIGINS=http://localhost:5173       # comma-separated allowlist, never `*`   [server]


# ─── Object storage: MinIO locally, S3-compatible anywhere ────────────────────
# MINIO_ROOT_* configure the container; S3_* are what the app reads.
MINIO_ROOT_USER=garhminio
MINIO_ROOT_PASSWORD=garhminio_local_dev        # MinIO requires >= 8 chars
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001                        # browse at http://localhost:9001

S3_ENDPOINT_URL=http://minio:9000              # [both]  in-cluster
S3_ACCESS_KEY_ID=garhminio                     # [both]
S3_SECRET_ACCESS_KEY=garhminio_local_dev       # [both]  SECRET
S3_BUCKET=garh-local                           # [both]
S3_REGION=ap-south-1                           # Mumbai — matches the India-residency claim (§15)   [both]
S3_FORCE_PATH_STYLE=true                       # required by MinIO   [both]
S3_SIGNED_URL_TTL_SECONDS=600                  # <= 10 min (§13)   [both]
# Browser-facing origin used when signing download URLs: inside the network the
# API talks to `minio`, but the browser can only resolve `localhost`.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # NOT READ YET — no S3 client exists in
#   garh_api (downloads 307-redirect to the stored object URL, see routers/jobs.py
#   note 8). Whoever adds presigning must add a matching Settings field.


# ─── Provider: LLM (brief parse + copilot, §10) ───────────────────────────────
# `mock` is fixture-driven and deterministic. The full app — including the
# copilot eval set and every e2e test — runs green on `mock`.
PROVIDER_LLM=mock                              # mock | anthropic   [both]
ANTHROPIC_API_KEY=                             # [worker] SECRET — required only when PROVIDER_LLM=anthropic
ANTHROPIC_MODEL=claude-opus-5                  # [worker]
LLM_MAX_OUTPUT_TOKENS=8192                     # [worker]
LLM_TEMPERATURE=0.2                            # <= 0.3 (§10)   [worker]
LLM_SCHEMA_RETRIES=2                           # max 2 retries on schema violation (§10)   [worker]
LLM_TIMEOUT_SECONDS=60                         # [worker]
LLM_FIXTURE_DIR=fixtures/copilot-commands      # [worker] mock provider reads from here


# ─── Provider: render (§9) ────────────────────────────────────────────────────
# `mock` composites the client viewport PNG with a preset-tinted gradient and a
# watermark: instant, deterministic by seed, no GPU. Keeps the product
# e2e-testable with no weights on disk.
PROVIDER_RENDER=mock                           # mock | diffusers   [both]
RENDER_DEVICE=cpu                              # cpu | cuda   [worker]
RENDER_CONCURRENCY_PER_FIRM=4                  # (§9)   [server]
RENDER_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0    # [worker]
# Licence guard (§9): the worker asserts RENDER_MODEL_ID is in this allowlist.
# FLUX.1-dev is non-commercial and must never appear here.
RENDER_MODEL_ALLOWLIST=stabilityai/stable-diffusion-xl-base-1.0,black-forest-labs/FLUX.1-schnell,Qwen/Qwen-Image
RENDER_UPSCALER=RealESRGAN_x2plus               # BSD-3   [worker]
RENDER_OUTPUT_WIDTH=2048                        # 2K only at MVP (spec F6)   [worker]
RENDER_OUTPUT_HEIGHT=1152                       # [worker]
RENDER_SAFETY_CHECKER=true                      # (§9)   [worker]
RENDER_TIMEOUT_SECONDS=180                      # [worker]
HF_HOME=/app/.cache/huggingface                 # [worker] weight cache on a named volume


# ─── Provider: billing (§F10, D11) ────────────────────────────────────────────
PROVIDER_BILLING=mock                          # mock | razorpay   [server]
RAZORPAY_KEY_ID=                               # [server]
RAZORPAY_KEY_SECRET=                           # [server] SECRET
RAZORPAY_WEBHOOK_SECRET=                       # NOT READ YET — billing is Phase 9 (D11);
#   PROVIDER_BILLING has no implementation behind it yet.


# ─── Rate limits (§11, §13) ───────────────────────────────────────────────────
RATE_LIMIT_OPS_PER_SECOND=60                   # per firm (§11)   [server]
RATE_LIMIT_SOLVER_JOBS_PER_HOUR=10             # per firm, free tier (§11)   [server]
RATE_LIMIT_AUTH_PER_HOUR=20                    # per IP on the OTP endpoints (§13)   [server]
# Per firm on the routes that call a language model (POST /projects/:id/brief/parse
# now, the copilot in Phase 6). The only endpoints that spend money at a third party
# per request, so this is the one product limit that FAILS CLOSED: if Redis cannot
# count the call, the call is not made. Spend is recorded as credit_events(kind='llm').
RATE_LIMIT_LLM_PER_HOUR=60                     # per firm (§13)   [server]


# ─── Request bodies & uploads (§13: parsed in a worker, timeout + memory capped) ─
# Hard ceiling on ANY request body the API will read. Every endpoint today takes
# JSON, and the largest legitimate one (an op append) is orders of magnitude under
# this — it exists so an unauthenticated caller cannot make the process buffer an
# arbitrary number of bytes before a validator runs. Enforced by
# BodySizeLimitMiddleware against Content-Length AND the streamed byte count, so
# `Transfer-Encoding: chunked` cannot slip past it. A route that legitimately needs
# more must be listed in garh_api.main.LARGE_BODY_PATH_SUFFIXES.
MAX_REQUEST_BODY_BYTES=8388608                 # 8 MB   [server]
# Enforced TWICE on purpose: the API refuses the upload at the edge, and the drawings
# worker re-checks after fetching the blob (a blob can change between enqueue and pop,
# and the envelope's sizeBytes is a claim rather than a measurement). Both sides read
# THIS variable — services/drawings/handler.py used to hard-code 20 MB, so raising the
# limit here made the API accept a file the worker then rejected.
MAX_DXF_UPLOAD_BYTES=20971520                  # 20 MB   [both]
MAX_IMAGE_UPLOAD_BYTES=10485760                # 10 MB   [server]
DXF_PARSE_TIMEOUT_SECONDS=10                   # a malicious DXF must fail, not hang   [worker]
DXF_PARSE_MEMORY_LIMIT_MB=512                  # [worker]


# ─── Model core / engine defaults ─────────────────────────────────────────────
OP_SNAPSHOT_INTERVAL=200                       # fold snapshot cadence (§2)   [server]
MAX_OPS_PER_APPEND=500                         # cap on one POST /ops batch   [server]
COMPLIANCE_DEBOUNCE_MS=500                     # NOT READ YET — the debounce is a client
#   constant today (apps/web); promote to a Settings field when the server needs it.
RULEPACK_DIR=rulepacks                         # [both]
# Directory GET /catalog/* reads its furniture / materials / facade-kit overrides
# from. Unset, the API falls back to <repo>/catalog then <repo>/fixtures/catalog;
# compose sets it to /app/fixtures/catalog explicitly so the files the seed
# validates are the files the app serves. Every /catalog response reports which it
# used (`source: builtin | files`).
GARH_CATALOG_DIR=fixtures/catalog              # [server]
FIXTURE_DIR=fixtures                           # [both]
DEFAULT_UNITS_DISPLAY=ft-in                    # NOT READ YET — the default lives in the
#   DB column default (projects.units = 'ft-in', migration 0001) and in
#   garh_model.model._Defaults. Documented here so the two are not surprising.
DEFAULT_CITY_PACK=blr                          # NOT READ YET — projects carry city_pack
#   explicitly; the seed demo project hard-codes 'blr'.


# ─── Feature flags ────────────────────────────────────────────────────────────
# NOT READ FROM ENV. Flags live in the global `flags` table and are read at boot
# by garh_api.repositories.flags.FLAG_REGISTRY.refresh(); per-firm overrides come
# from firms.settings["flags"]. These five lines document the seeded defaults in
# FLAG_REGISTRY so the shipped state is greppable — editing them here changes
# nothing. Change the seed in repositories/flags.py, or flip the row.
FLAG_FACADE_V2=false
FLAG_INTERIOR_PRECISE=false                     # interior-Precise is v1.1 (D5)
FLAG_PDF_TRACE_IMPORT=false                     # v1.1 (D5)
FLAG_MULTIPLAYER=false                          # v2.5 (D12)
FLAG_DEMO_PROJECT_ON_SIGNUP=true                # (§15 first-run)


# ─── Worker runtime (services/common/config.py) ────────────────────────────────
# WORKER_NAME / WORKER_QUEUE / WORKER_CONCURRENCY are set per service in
# docker-compose.yml, not here. Everything below is a real knob with a real
# default; `make env-audit` fails if a WorkerSettings field is missing from this
# file, which is how these came to be documented in the first place.
APP_NAME=garh-api                              # [server] structlog service tag
WORKER_SHUTDOWN_GRACE_SECONDS=30               # [worker] SIGTERM → drain deadline
WORKER_HEARTBEAT_INTERVAL_SECONDS=30           # [worker] lease renewal (< visibility timeout)
WORKER_HEALTH_HOST=0.0.0.0                     # [worker] container-local health server
WORKER_HEALTH_PORT=8081                        # [worker] GET /healthz per worker (§18)

QUEUE_RESERVE_TIMEOUT_SECONDS=5                # [worker] blocking pop; also shutdown granularity
QUEUE_RETRY_BACKOFF_MAX_SECONDS=600            # [worker] cap on exponential backoff
QUEUE_DEAD_LETTER_MAXLEN=1000                  # [worker] a DLQ without a cap is a memory leak
QUEUE_SWEEP_INTERVAL_SECONDS=10                # [worker] lease + delayed-set maintenance

PROGRESS_LOG_MAXLEN=200                        # [worker] SSE resume backlog per job
PROGRESS_TTL_SECONDS=3600                      # [worker] progress keys expire
JOB_CHECKPOINT_TTL_SECONDS=86400               # [worker] resumable jobs, not immortal ones
JOB_EVENTS_STREAM=garh:events:jobs             # [both]   worker → API durable transitions
JOB_EVENTS_MAXLEN=10000                        # [both]   stream cap

BLOB_HTTP_TIMEOUT_SECONDS=60                   # [worker] presigned GET/PUT timeout
BLOB_MAX_BYTES=67108864                        # [worker] 64 MB per artefact

ANTHROPIC_BASE_URL=                            # [server] blank = the SDK default
ANTHROPIC_VERSION=2023-06-01                   # [server] Messages API version header


# ══════════════════════════════════════════════════════════════════════════════
# CLIENT BUNDLE — everything below is PUBLIC. It ships to every browser.
# Never add a key, password, secret DSN, or connection string here.
# ══════════════════════════════════════════════════════════════════════════════
VITE_API_BASE_URL=http://localhost:8000/api/v1  # [client]
VITE_APP_NAME=Garh AI                           # [client]
VITE_APP_URL=http://localhost:5173              # [client]
VITE_HMR_PORT=24678                             # [client] dev only
VITE_SENTRY_DSN=                                # [client] browser DSN — public by design
VITE_ENABLE_DEVTOOLS=true                       # [client]
VITE_DEFAULT_UNITS=ft-in                        # [client]
