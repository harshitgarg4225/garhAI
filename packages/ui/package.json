{
  "name": "@garh/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Garh AI shared UI primitives: accessible, Tailwind-based, light+dark, mm/ft-in aware. Consumed as TypeScript source (no build step), same as @garh/model.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./src/*": "./src/*"
  },
  "files": [
    "src",
    "tailwind-preset.cjs"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@garh/model": "workspace:*"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "vitest": "2.1.2"
  },
  "engines": {
    "node": ">=20.11"
  }
}
