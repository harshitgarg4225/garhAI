    "room.assign": {
      "title": "19. room.assign",
      "description": "Set a detected room's programme type, name, tags and lock flag. Never changes geometry.",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "room.assign"
        },
        "payload": {
          "type": "object",
          "required": ["roomId", "type"],
          "additionalProperties": false,
