    "column.set": {
      "title": "24. column.set (add | move | delete)",
      "description": "One op for all column edits; `action` selects the verb. Columns are coordination-only.",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "column.set"
        },
        "payload": {
          "type": "object",
          "required": ["action", "id"],
          "additionalProperties": false,
          "properties": {
            "action": {
              "enum": ["add", "move", "delete"]
            },
            "id": {
              "$ref": "common.schema.json#/$defs/ColumnId"
            },
            "storeyId": {
              "$ref": "common.schema.json#/$defs/StoreyId"
            },
            "pt": {
              "$ref": "common.schema.json#/$defs/Pt"
            },
            "sizeMm": {
              "$ref": "common.schema.json#/$defs/SizeMm"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "action": {
                    "const": "add"
                  }
                },
                "required": ["action"]
              },
              "then": {
                "required": ["storeyId", "pt"]
              }
            },
            {
              "if": {
                "properties": {
                  "action": {
                    "const": "move"
                  }
                },
                "required": ["action"]
              },
              "then": {
                "required": ["pt"]
              }
            }
          ]
        },
        "groupId": {
          "$ref": "common.schema.json#/$defs/GroupId"
        },
        "clientOpId": {
          "type": "string",
          "maxLength": 128
        },
        "source": {
          "$ref": "common.schema.json#/$defs/OpSource"
        }
      }
