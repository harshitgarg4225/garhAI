{
  "name": "@garh/model",
  "version": "0.1.0",
  "private": true,
  "description": "Garh AI model core: integer-mm geometry, the HouseModel document, the 32-op taxonomy, fold/replay, validation and room detection. The contract every other package codes against.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema/*": "./schema/*"
  },
  "files": [
    "src",
    "schema"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run src/units.test.ts src/fold.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "ulid": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "typescript": "5.6.2",
    "vitest": "2.1.2"
  },
  "engines": {
    "node": ">=20.11"
  }
}
