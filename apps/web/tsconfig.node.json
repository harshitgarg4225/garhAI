{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Build-time files: they run in Node before a bundle exists, so they may
     * use `node:` builtins that the app config deliberately cannot see. */
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,

    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "postcss.config.js"]
}
