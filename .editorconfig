# https://editorconfig.org
# Mirrors Prettier (printWidth 100) and Ruff (line-length 100) so editors,
# formatters and CI agree. Changing a width here means changing it in
# .prettierrc and apps/api/pyproject.toml [tool.ruff] too.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.{py,pyi}]
indent_size = 4

[*.{md,mdx}]
# Trailing whitespace is significant in Markdown (hard line break).
trim_trailing_whitespace = false

[Makefile]
# Make requires literal tabs to open a recipe line.
indent_style = tab

[*.{dxf,svg}]
# Golden artefacts: never reformat, never trim — byte-compared in CI.
insert_final_newline = unset
trim_trailing_whitespace = false
max_line_length = unset

[*.{json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 2
